{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "wavex",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wavex",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["acrylic"]
        },
        "backgroundThrottling": "throttle",
        "shadow": true
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "sidebarImage": "icons/windows-installer.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": null
  }
}
